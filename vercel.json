    { "source": "/guide/ably-image-guide", "destination": "https://seller-image-tool.netlify.app/guide", "permanent": true },
    { "source": "/guide/zigzag-image-guide", "destination": "https://seller-image-tool.netlify.app/guide", "permanent": true },
    { "source": "/guide/ssg-image-guide", "destination": "https://seller-image-tool.netlify.app/guide", "permanent": true },
    { "source": "/guide/lotteon-image-guide", "destination": "https://seller-image-tool.netlify.app/guide", "permanent": true },
    { "source": "/guide/wemakeprice-image-guide", "destination": "https://seller-image-tool.netlify.app/guide", "permanent": true },
    { "source": "/:path*", "destination": "https://seller-image-tool.netlify.app/:path*", "permanent": true }
